# Keeps the agent worker running and restarts it if it stops.
# Copy to /etc/systemd/system/forkwise-agent.service, change the paths, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now forkwise-agent
#   journalctl -u forkwise-agent -f      (to watch the log)

[Unit]
Description=Forkwise Agent worker
After=network.target docker.service
Requires=docker.service

[Service]
User=forkwise
WorkingDirectory=/home/forkwise/forkwise/backend
ExecStart=/usr/bin/python3 agent_worker.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
