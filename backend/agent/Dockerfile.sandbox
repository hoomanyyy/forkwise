FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git nodejs npm ca-certificates coreutils ffmpeg fonts-dejavu-core fonts-vazirmatn \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir pytest pillow

RUN useradd -m -u 1000 agent && mkdir /workspace && chown agent:agent /workspace

USER agent
WORKDIR /workspace
CMD ["sleep", "infinity"]
