FROM python:3.12-slim

# tools for code, media, a real browser and a virtual desktop the agent can control
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git nodejs npm ca-certificates coreutils curl procps psmisc \
        ffmpeg fonts-dejavu-core fonts-vazirmatn fonts-noto-color-emoji \
        chromium xvfb xdotool fluxbox scrot x11-utils x11-xserver-utils xterm \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir pytest pillow playwright requests

RUN useradd -m -u 1000 agent && mkdir /workspace && chown agent:agent /workspace

COPY box/fwtool.py /opt/forkwise/fwtool.py
RUN chmod 755 /opt/forkwise/fwtool.py

ENV FW_CHROMIUM=/usr/bin/chromium \
    FW_DISPLAY=:99 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

USER agent
WORKDIR /workspace
CMD ["sleep", "infinity"]
