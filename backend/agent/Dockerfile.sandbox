# The image every fork runs in.
# Build it once on the worker server:
#   docker build -t forkwise-sandbox -f agent/Dockerfile.sandbox agent
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git nodejs npm ca-certificates coreutils \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir pytest

# The agent never runs as root.
RUN useradd -m -u 1000 agent && mkdir /workspace && chown agent:agent /workspace

USER agent
WORKDIR /workspace
CMD ["sleep", "infinity"]
