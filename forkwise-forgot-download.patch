diff --git a/frontend/src/pages/Download.js b/frontend/src/pages/Download.js
new file mode 100644
index 0000000..c71d741
--- /dev/null
+++ b/frontend/src/pages/Download.js
@@ -0,0 +1,140 @@
+import React, { useEffect, useState } from "react"
+import "bootstrap/dist/css/bootstrap.min.css"
+import "../styles/Site.css"
+import "../styles/Pages.css"
+import { Link } from "react-router-dom"
+import { FaAndroid, FaApple, FaDownload, FaShieldAlt, FaUserCheck, FaHistory, FaBolt, FaMobileAlt } from "react-icons/fa"
+import Navbar from "../components/Navbar"
+import Footer from "../components/Footer"
+import Seo from "../components/Seo"
+import Logo from "../images/logo.svg"
+
+const APK_URL = "/downloads/forkwise.apk"
+const VERSION = "1.0.0"
+
+const schema = {
+    "@context": "https://schema.org",
+    "@type": "MobileApplication",
+    "name": "Forkwise",
+    "operatingSystem": "Android 6.0 or newer",
+    "applicationCategory": "EducationalApplication",
+    "softwareVersion": VERSION,
+    "downloadUrl": "https://forkwise.online" + APK_URL,
+    "url": "https://forkwise.online/download",
+    "description": "Run a multiverse analysis on your phone. Many AI analysts study your data and Forkwise tells you how robust the answer is.",
+    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
+}
+
+const STEPS = [
+    { title: "Download the file", text: "Tap the download button on your Android phone. The file is called forkwise.apk." },
+    { title: "Allow the install", text: "Open the file. Android may ask you to allow installs from your browser. Tap Settings, turn on \"Allow from this source\" and go back." },
+    { title: "Log in", text: "Open Forkwise and log in with the same account you use on the website, or create a new one." }
+]
+
+export default function Download() {
+    const [size, setSize] = useState("")
+    const [ready, setReady] = useState(true)
+
+    useEffect(() => {
+        fetch(APK_URL, { method: "HEAD" })
+            .then((res) => {
+                const type = res.headers.get("content-type") || ""
+                if (!res.ok || type.includes("text/html")) {
+                    setReady(false)
+                    return
+                }
+                const bytes = Number(res.headers.get("content-length"))
+                if (bytes > 0) {
+                    setSize((bytes / 1024 / 1024).toFixed(1) + " MB")
+                }
+            })
+            .catch(() => {})
+    }, [])
+
+    return (
+        <div className="SitePage">
+            <Seo
+                title="Download the Forkwise Android App"
+                description="Get Forkwise on your Android phone. Upload your data, let many AI analysts study it and see a clear verdict. Free, same account as the website."
+                path="/download"
+                schema={schema}
+            />
+            <Navbar />
+
+            <main className="PageBody PageNarrow">
+                <div className="PageHead">
+                    <p className="SectionTag">Android app</p>
+                    <h1 className="PageTitle">Forkwise on your phone</h1>
+                    <p className="PageLead">The same tool as the website, made for your phone. Start an analysis, follow your results and open your history anywhere.</p>
+                </div>
+
+                <section className="DownloadCard">
+                    <img src={Logo} alt="Forkwise app icon" className="DownloadIcon" width="88" height="88" />
+                    <div className="DownloadInfo">
+                        <h2>Forkwise for Android</h2>
+                        <p>Version {VERSION}{size !== "" ? " · " + size : ""} · Android 6.0 or newer · Free</p>
+                        {ready ? (
+                            <a href={APK_URL} download className="btn MainButton ApkButton">
+                                <FaDownload /> Download for Android
+                            </a>
+                        ) : (
+                            <span className="DownloadSoon">The app file is being updated. Please check again soon.</span>
+                        )}
+                    </div>
+                    <div className="DownloadQr">
+                        <img src="/downloads/qr.svg" alt="QR code for forkwise.online/download" width="120" height="120" />
+                        <span>On a computer? Scan this with your phone.</span>
+                    </div>
+                </section>
+
+                <div className="DownloadFeatures">
+                    <div><FaUserCheck /><b>One account</b><span>Log in with your website account.</span></div>
+                    <div><FaBolt /><b>5 analyses a day</b><span>Free for every user.</span></div>
+                    <div><FaHistory /><b>Your history</b><span>See every past run and verdict.</span></div>
+                    <div><FaMobileAlt /><b>Made for phones</b><span>Simple steps and big buttons.</span></div>
+                </div>
+
+                <h2 className="DownloadTitle">How to install</h2>
+                <div className="MethodList">
+                    {STEPS.map((s, i) => (
+                        <div className="MethodStep" key={s.title}>
+                            <div className="MethodIcon">{i + 1}</div>
+                            <div className="MethodText">
+                                <h2>{s.title}</h2>
+                                <p>{s.text}</p>
+                            </div>
+                        </div>
+                    ))}
+                </div>
+
+                <section className="PrivacyCard DownloadNote">
+                    <h2><FaShieldAlt /> Why does Android show a warning?</h2>
+                    <p>
+                        Forkwise is not on Google Play yet, so Android asks before it installs an app from a website.
+                        This is normal. Only download the app from forkwise.online, never from another site.
+                    </p>
+                </section>
+
+                <section className="PrivacyCard">
+                    <h2><FaApple /> Have an iPhone?</h2>
+                    <p>
+                        There is no iPhone app yet. The website works well on iPhone, so open <Link to="/">forkwise.online</Link> in
+                        Safari. You can tap Share and then "Add to Home Screen" to keep it like an app.
+                    </p>
+                </section>
+
+                <section className="PageCall">
+                    <h2><FaAndroid /> Ready to try it?</h2>
+                    <p>Free, no card, the same account on the phone and the website.</p>
+                    {ready ? (
+                        <a href={APK_URL} download className="btn MainButton">Download the app</a>
+                    ) : (
+                        <Link to="/register" className="btn MainButton">Use the website</Link>
+                    )}
+                </section>
+            </main>
+
+            <Footer />
+        </div>
+    )
+}
diff --git a/frontend/src/pages/ForgotPassword.js b/frontend/src/pages/ForgotPassword.js
new file mode 100644
index 0000000..a623f47
--- /dev/null
+++ b/frontend/src/pages/ForgotPassword.js
@@ -0,0 +1,172 @@
+import React, { useEffect, useState } from "react"
+import "bootstrap/dist/css/bootstrap.min.css"
+import "../styles/Register.css"
+import { FaEnvelope, FaLock, FaShieldAlt, FaEye, FaEyeSlash, FaCheck } from "react-icons/fa"
+import { Link, useNavigate } from "react-router-dom"
+import Logo from "../images/logo.svg"
+import Seo from "../components/Seo"
+import { sendAuthRequestWithWebsocket } from "../api"
+
+export default function ForgotPassword() {
+    const navigate = useNavigate()
+    const [step, setStep] = useState(1)
+    const [email, setEmail] = useState("")
+    const [code, setCode] = useState("")
+    const [password, setPassword] = useState("")
+    const [showPassword, setShowPassword] = useState(false)
+    const [error, setError] = useState("")
+    const [success, setSuccess] = useState("")
+    const [sending, setSending] = useState(false)
+    const [codeWait, setCodeWait] = useState(0)
+
+    useEffect(() => {
+        if (codeWait <= 0) {
+            return
+        }
+        const timer = setTimeout(() => setCodeWait(codeWait - 1), 1000)
+        return () => clearTimeout(timer)
+    }, [codeWait])
+
+    function SendCode(e) {
+        if (e) {
+            e.preventDefault()
+        }
+        setError("")
+        setSuccess("")
+
+        if (!email.includes("@") || !email.includes(".")) {
+            setError("Please write the email of your account.")
+            return
+        }
+
+        setSending(true)
+        sendAuthRequestWithWebsocket({ type: "send_reset_code", email: email.trim() }, (result) => {
+            setSending(false)
+            if (result.Message === true) {
+                setStep(2)
+                setCodeWait(60)
+                setSuccess("If an account uses " + email.trim() + ", we sent an 8 digit code to it. Check your spam folder too.")
+            } else if (result.Error === true) {
+                setError("Could not connect to the server. Please try again.")
+            } else {
+                setError(result.error || "Could not send the code. Please try again.")
+            }
+        })
+    }
+
+    function ChangePassword(e) {
+        e.preventDefault()
+        setError("")
+
+        if (code.trim().length !== 8) {
+            setError("Please write the 8 digit code from your email.")
+            return
+        }
+        if (password.length < 8) {
+            setError("Your new password needs at least 8 characters.")
+            return
+        }
+
+        setSending(true)
+        sendAuthRequestWithWebsocket({
+            type: "reset_password",
+            email: email.trim(),
+            otp_code: code.trim(),
+            password: password
+        }, (result) => {
+            setSending(false)
+            if (result.Message === true) {
+                setSuccess("Your password was changed. Taking you to log in...")
+                setStep(3)
+                setTimeout(() => navigate("/auth/login"), 1800)
+            } else if (result.Error === true) {
+                setError("Could not connect to the server. Please try again.")
+            } else {
+                setError(result.error || "Could not change the password. Please try again.")
+            }
+        })
+    }
+
+    return (
+        <div className="SignupPage">
+            <Seo title="Reset your password | Forkwise" noindex />
+            <div className="SignupShell">
+                <aside className="SignupSide">
+                    <Link to="/" className="SideBrand">
+                        <img src={Logo} alt="Logo" className="SideLogo" />
+                        <span>Forkwise</span>
+                    </Link>
+                    <h2 className="SideTitle">Forgot your password? It happens.</h2>
+                    <ul className="SideList">
+                        <li><FaCheck /> We send a code to your email</li>
+                        <li><FaCheck /> You choose a new password</li>
+                        <li><FaCheck /> Your analyses stay safe</li>
+                    </ul>
+                    <p className="SideNote">A-ISPC 2026 project</p>
+                </aside>
+
+                <form className="SignupCard LoginCard" onSubmit={step === 1 ? SendCode : ChangePassword} noValidate>
+                    <h3 className="SignupTitle">Reset your password</h3>
+                    <p className="SignupSubtitle">
+                        {step === 1 ? "Write the email you used to sign up." : "Write the code and your new password."}
+                    </p>
+
+                    <label className="SignupField">
+                        <span>Email</span>
+                        <div className="IconInput">
+                            <FaEnvelope className="FieldIcon" />
+                            <input type="email" value={email} onChange={(e) => setEmail(e.target.value)} placeholder="you@example.com" disabled={step !== 1} autoFocus />
+                        </div>
+                    </label>
+
+                    {step >= 2 && (
+                        <>
+                            <label className="SignupField">
+                                <span>Code from your email</span>
+                                <div className="SignupCodeRow">
+                                    <div className="IconInput">
+                                        <FaShieldAlt className="FieldIcon" />
+                                        <input value={code} onChange={(e) => setCode(e.target.value.replace(/[^0-9]/g, ""))} placeholder="8 digit code" inputMode="numeric" maxLength={8} autoComplete="one-time-code" />
+                                    </div>
+                                    <button type="button" className="SignupCodeButton" onClick={() => SendCode()} disabled={sending || codeWait > 0 || step === 3}>
+                                        {codeWait > 0 ? "Send again in " + codeWait + "s" : "Send again"}
+                                    </button>
+                                </div>
+                            </label>
+
+                            <label className="SignupField">
+                                <span>New password</span>
+                                <div className="IconInput">
+                                    <FaLock className="FieldIcon" />
+                                    <input type={showPassword ? "text" : "password"} value={password} onChange={(e) => setPassword(e.target.value)} placeholder="At least 8 characters" autoComplete="new-password" />
+                                    <button type="button" className="EyeButton" onClick={() => setShowPassword(!showPassword)} aria-label="Show password">
+                                        {showPassword ? <FaEyeSlash /> : <FaEye />}
+                                    </button>
+                                </div>
+                            </label>
+                        </>
+                    )}
+
+                    {error !== "" && <div className="SignupError">{error}</div>}
+                    {success !== "" && <div className="SignupSuccess">{success}</div>}
+
+                    <button type="submit" className="SignupButton" disabled={sending || step === 3}>
+                        {step === 1
+                            ? (sending ? "Sending..." : "Send me a code")
+                            : (sending ? "Saving..." : "Change password")}
+                    </button>
+
+                    {step === 2 && (
+                        <p className="SignupFooter">
+                            Wrong email? <button type="button" className="SignupTextButton" onClick={() => { setStep(1); setCode(""); setError(""); setSuccess("") }}>Change it</button>
+                        </p>
+                    )}
+
+                    <p className="SignupFooter">
+                        Remember it now? <Link to="/auth/login">Log in</Link>
+                    </p>
+                </form>
+            </div>
+        </div>
+    )
+}
